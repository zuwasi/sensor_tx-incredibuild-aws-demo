# =============================================================================
# Makefile.threadx - Eclipse ThreadX RTOS Sensor Demo
# SCD Training Demo - 02-Feb-2026
# =============================================================================
# Build with: make -f Makefile.threadx
# Clean with: make -f Makefile.threadx clean
# =============================================================================

# Compiler and flags
CC = clang
AR = llvm-ar
RM = del /F /Q
RMDIR = if exist

# Directories
THREADX_COMMON_SRC = threadx/common/src
THREADX_COMMON_INC = threadx/common/inc
THREADX_PORT_SRC = threadx_port/src
THREADX_PORT_INC = threadx_port/inc
BUILD_DIR = build_threadx

# Include paths
INCLUDES = -I$(THREADX_COMMON_INC) \
           -I$(THREADX_PORT_INC) \
           -I.

# Compiler flags
CFLAGS = -Wall -Wextra -g -O0 \
         -DTX_INCLUDE_USER_DEFINE_FILE \
         $(INCLUDES)

# Linker flags - winmm for multimedia timer
LDFLAGS = -lwinmm

# =============================================================================
# ThreadX Library Source Files
# =============================================================================

