TX_PORT_SRCS = \
    $(THREADX_PORT_SRC)/tx_initialize_low_level.c \
    $(THREADX_PORT_SRC)/tx_thread_context_restore.c \
    $(THREADX_PORT_SRC)/tx_thread_context_save.c \
    $(THREADX_PORT_SRC)/tx_thread_interrupt_control.c \
    $(THREADX_PORT_SRC)/tx_thread_schedule.c \
    $(THREADX_PORT_SRC)/tx_thread_stack_build.c \
    $(THREADX_PORT_SRC)/tx_thread_system_return.c \
    $(THREADX_PORT_SRC)/tx_timer_interrupt.c

# =============================================================================
# Application Source Files
# =============================================================================

APP_SRCS = sensor_threadx.c

# =============================================================================
# Object Files
# =============================================================================

TX_COMMON_OBJS = $(patsubst $(THREADX_COMMON_SRC)/%.c,$(BUILD_DIR)/tx_common/%.o,$(TXE_COMMON_SRCS) $(TX_COMMON_SRCS))
TX_PORT_OBJS = $(patsubst $(THREADX_PORT_SRC)/%.c,$(BUILD_DIR)/tx_port/%.o,$(TX_PORT_SRCS))
APP_OBJS = $(patsubst %.c,$(BUILD_DIR)/%.o,$(APP_SRCS))

# ThreadX library
TX_LIB = $(BUILD_DIR)/libtx.a

# Final executable
TARGET = sensor_threadx.exe

# =============================================================================
# Build Targets
# =============================================================================

.PHONY: all clean dirs lib app

all: dirs lib app
	@echo "=========================================="
	@echo " Build complete: $(TARGET)"
	@echo " Run with: ./$(TARGET)"
	@echo "=========================================="

dirs:
	@if not exist $(BUILD_DIR) mkdir $(BUILD_DIR)
	@if not exist $(BUILD_DIR)\tx_common mkdir $(BUILD_DIR)\tx_common
	@if not exist $(BUILD_DIR)\tx_port mkdir $(BUILD_DIR)\tx_port

lib: dirs $(TX_LIB)
	@echo "ThreadX library built: $(TX_LIB)"

app: lib $(TARGET)

$(TX_LIB): $(TX_COMMON_OBJS) $(TX_PORT_OBJS)
	@echo "Creating ThreadX library..."
	$(AR) rcs $@ $^

$(TARGET): $(APP_OBJS) $(TX_LIB)
	@echo "Linking application..."
	$(CC) -o $@ $(APP_OBJS) -L$(BUILD_DIR) -ltx $(LDFLAGS)

# =============================================================================
# Compilation Rules
# =============================================================================

$(BUILD_DIR)/tx_common/%.o: $(THREADX_COMMON_SRC)/%.c
	@echo "Compiling: $<"
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/tx_port/%.o: $(THREADX_PORT_SRC)/%.c
	@echo "Compiling: $<"
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.c
	@echo "Compiling: $<"
	$(CC) $(CFLAGS) -c $< -o $@

# =============================================================================
# Clean Target
# =============================================================================

clean:
	@echo "Cleaning build files..."
	$(RMDIR) $(BUILD_DIR) rmdir /S /Q $(BUILD_DIR)
	-$(RM) $(TARGET)
	@echo "Clean complete."

# =============================================================================
# Help Target
# =============================================================================

help:
	@echo "Eclipse ThreadX Sensor Demo - Build System"
	@echo "==========================================="
	@echo ""
	@echo "Targets:"
	@echo "  all     - Build everything (default)"
	@echo "  lib     - Build ThreadX library only"
	@echo "  app     - Build application (requires lib)"
	@echo "  clean   - Remove all build files"
	@echo "  help    - Show this help"
	@echo ""
	@echo "Usage:"
	@echo "  make -f Makefile.threadx"
	@echo "  make -f Makefile.threadx clean"
